// ============================================================================
// MAIN IMAGE TAB - REINHARD TONE MAPPING & DISPLAY
// ============================================================================
void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    vec2 uv = fragCoord / iResolution.xy;
    vec3 rawDensity = texture(iChannel0, uv).rgb;

    // 1. Exposure adjustment
    vec3 color = rawDensity * 1.2;

    // 2. Reinhard tone mapping compresses HDR highlights to prevent blowout
    color = color / (vec3(1.0) + color);

    // 3. Gamma correction (sRGB curve)
    color = pow(color, vec3(1.0 / 2.2));

    fragColor = vec4(color, 1.0);
}

// ============================================================================
// PERSISTENT 5D BARNSLEY "HYPER-IFS" ENGINE (BUFFER A - RESOLUTION ENHANCED)
// ============================================================================

#define KEY_SPACE 32 // [Spacebar] : Toggle Automatic 5D Camera Orbit / Twist

// Camera Movement Controls (XY Plane)
#define KEY_W 87     // [W] : Move Up (+Y)
#define KEY_S 83     // [S] : Move Down (-Y)
#define KEY_A 65     // [A] : Move Left (-X)
#define KEY_D 68     // [D] : Move Right (+X)

// 4D / 5D Rotation Controls
#define KEY_Q 81     // [Q] : Roll in ZW Hyperplane (Counter-Clockwise)
#define KEY_E 69     // [E] : Roll in ZW Hyperplane (Clockwise)
#define KEY_1 49     // [1] : Roll in WV Hyperplane (Counter-Clockwise)
#define KEY_2 50     // [2] : Roll in WV Hyperplane (Clockwise)

// Camera Zoom Controls
#define KEY_Z 90     // [Z] : Zoom In  (Narrows FOV)
#define KEY_X 88     // [X] : Zoom Out (Widens FOV)

// Camera Depth Controls (Z Axis)
#define KEY_N 78     // [N] : Dolly Forward (-Z)
#define KEY_M 77     // [M] : Dolly Backward (+Z)

// Vertical Fractal Spine Offset Controls
#define KEY_F 70     // [F] : Shift Spine Upward
#define KEY_R 82     // [R] : Shift Spine Downward

mat2 rot2D(float a) {
    float c = cos(a), s = sin(a);
    return mat2(c, -s, s, c);
}

int seed = 1;
void srand(int s) { seed = s; }
int rand() { seed = seed * 0x343fd + 0x269ec3; return (seed >> 16) & 32767; }
float frand() { return float(rand()) / 32767.0; }

int hash(int n) {
    n = (n << 13) ^ n;
    return n * (n * n * 15731 + 789221) + 1376312589;
}

bool isKeyPressed(int keyCode) {
    return texelFetch(iChannel1, ivec2(keyCode, 0), 0).x > 0.5;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    ivec2 px = ivec2(fragCoord);

    // Seed RNG early for jitter computation
    srand(hash(px.x + hash(px.y + hash(iFrame))));

    // Sub-pixel jitter offset for multi-frame anti-aliasing
    vec2 jitter = (vec2(frand(), frand()) - 0.5) / iResolution.xy;
    vec2 uv = ((fragCoord + jitter) - 0.5 * iResolution.xy) / iResolution.y;

    // --- READ PERSISTENT STATE FROM MEMORY TEXELS ---
    vec4 state0 = texelFetch(iChannel0, ivec2(0, 0), 0); // CamX, CamY, CamZ, FOV
    vec4 state1 = texelFetch(iChannel0, ivec2(1, 0), 0); // Yaw, Pitch, ZWRoll, SpinePos
    vec4 state2 = texelFetch(iChannel0, ivec2(2, 0), 0); // WVRoll, LastMx, LastMy, MouseDown
    vec4 state3 = texelFetch(iChannel0, ivec2(3, 0), 0); // AutoPanActive, SpacePrev, 0, 0

    // Initialization on Frame 0
    if (iFrame == 0) {
        state0 = vec4(0.0, 0.0, 2.5, 1.0);
        state1 = vec4(0.0, 0.0, 0.45, 5.0);
        state2 = vec4(0.25, iMouse.xy, 0.0);
        state3 = vec4(1.0, 0.0, 0.0, 0.0); // Auto-orbit/twist ON by default
    }

    vec3 camPos     = state0.xyz;
    float fov       = state0.w;
    float yaw       = state1.x;
    float pitch     = state1.y;
    float zwRoll    = state1.z;
    float spinePos  = state1.w;
    float wvRoll    = state2.x;
    vec2 prevMouse  = state2.yz;
    
    float autoPanActive = state3.x;
    float spacePrev     = state3.y;

    // Save previous state for velocity calculation
    vec3 prevCamPos   = camPos;
    float prevYaw     = yaw;
    float prevPitch   = pitch;
    float prevZwRoll  = zwRoll;
    float prevWvRoll  = wvRoll;

    // --- SPACE BAR TOGGLE DEBOUNCE ---
    bool spacePressed = isKeyPressed(KEY_SPACE);
    if (spacePressed && spacePrev < 0.5) {
        autoPanActive = (autoPanActive > 0.5) ? 0.0 : 1.0;
    }
    spacePrev = spacePressed ? 1.0 : 0.0;

    // --- AUTO-ORBIT & AUTO-TWIST ANIMATION ---
    if (autoPanActive > 0.5) {
        float autoPanSpeed   = 0.35;
        float autoTwistSpeed = 1.20; 
        
        yaw    += autoPanSpeed * iTimeDelta;
        zwRoll += autoTwistSpeed * iTimeDelta;
    }

    // --- MOUSE PAN TRACKER ---
    vec2 mouse = iMouse.xy;
    if (iMouse.z > 0.0) {
        if (state2.w > 0.5) {
            vec2 mDelta = (mouse - prevMouse) / iResolution.xy;
            yaw   += mDelta.x * 3.14;
            pitch -= mDelta.y * 3.14;
            pitch  = clamp(pitch, -1.55, 1.55);
        }
        state2.w = 1.0;
    } else {
        state2.w = 0.0;
    }
    prevMouse = mouse;

    // --- FLIGHT CONTROLS ---
    float moveSpeed  = 0.025;
    float spineSpeed = 0.05;
    float fovSpeed   = 0.015;
    float rollSpeed  = 0.02;

    if (isKeyPressed(KEY_W)) camPos.y += moveSpeed;
    if (isKeyPressed(KEY_S)) camPos.y -= moveSpeed;
    if (isKeyPressed(KEY_A)) camPos.x -= moveSpeed;
    if (isKeyPressed(KEY_D)) camPos.x += moveSpeed;

    if (isKeyPressed(KEY_Q)) zwRoll -= rollSpeed;
    if (isKeyPressed(KEY_E)) zwRoll += rollSpeed;

    if (isKeyPressed(KEY_1)) wvRoll -= rollSpeed;
    if (isKeyPressed(KEY_2)) wvRoll += rollSpeed;

    if (isKeyPressed(KEY_Z)) fov *= (1.0 + fovSpeed);
    if (isKeyPressed(KEY_X)) fov *= (1.0 - fovSpeed);

    if (isKeyPressed(KEY_N)) camPos.z -= moveSpeed;
    if (isKeyPressed(KEY_M)) camPos.z += moveSpeed;

    if (isKeyPressed(KEY_F)) spinePos += spineSpeed;
    if (isKeyPressed(KEY_R)) spinePos -= spineSpeed;
    spinePos = clamp(spinePos, 0.0, 10.0);

    // --- WRITE MEMORY TEXELS (PROTECT STATE FROM DECAY) ---
    if (px == ivec2(0, 0)) { fragColor = vec4(camPos, fov); return; }
    if (px == ivec2(1, 0)) { fragColor = vec4(yaw, pitch, zwRoll, spinePos); return; }
    if (px == ivec2(2, 0)) { fragColor = vec4(wvRoll, prevMouse, state2.w); return; }
    if (px == ivec2(3, 0)) { fragColor = vec4(autoPanActive, spacePrev, 0.0, 0.0); return; }

    // --- MOTION DECAY & HIGH-ACCUMULATION LOGIC ---
    vec4 prevFrame = texelFetch(iChannel0, px, 0);

    float transVel = length(camPos - prevCamPos);
    float rotVel   = abs(yaw - prevYaw) + abs(pitch - prevPitch) + abs(zwRoll - prevZwRoll) + abs(wvRoll - prevWvRoll);

    float motion = clamp((transVel * 35.0) + (rotVel * 8.0), 0.0, 1.0);

    // High 0.992 decay when stationary allows long-term accumulation of razor-sharp detail
    float decayFactor = mix(0.992, 0.10, motion);
    vec3 density = prevFrame.rgb * decayFactor;

    float pointWeight = mix(0.12, 0.02, motion);
    int maxIterations = int(mix(8192.0, 1024.0, motion));

    // --- 5D AFFINE IFS FERN ENGINE ---
    vec2 q_xy = vec2(0.0);
    vec3 q_zwv = vec3(0.0);

    for (int i = 0; i < 8192; i++) {
        if (i >= maxIterations) break;

        float p = frand();

        if (p < 0.01) {
            q_xy  = vec2(0.0, 0.16 * q_xy.y);
            q_zwv = vec3(0.0);
        } else if (p < 0.86) {
            vec2 nxy = vec2(
                0.85 * q_xy.x + 0.04 * q_xy.y - 0.02 * q_zwv.x,
               -0.04 * q_xy.x + 0.85 * q_xy.y + 1.6
            );
            vec3 nzwv = vec3(
                0.02 * q_xy.x + 0.85 * q_zwv.x + 0.05 * q_zwv.y,
                0.85 * q_zwv.y - 0.05 * q_zwv.x + 0.03 * q_zwv.z + 0.1,
                0.85 * q_zwv.z - 0.03 * q_zwv.y
            );
            q_xy = nxy; q_zwv = nzwv;
        } else if (p < 0.93) {
            vec2 nxy = vec2(
                0.20 * q_xy.x - 0.26 * q_xy.y + 0.12 * q_zwv.x,
                0.23 * q_xy.x + 0.22 * q_xy.y + 1.6
            );
            vec3 nzwv = vec3(
               -0.12 * q_xy.x + 0.22 * q_zwv.x + 0.15 * q_zwv.y,
                0.22 * q_zwv.y - 0.15 * q_zwv.x + 0.20 * q_zwv.z + 0.2,
                0.22 * q_zwv.z + 0.15 * q_zwv.y + 0.25
            );
            q_xy = nxy; q_zwv = nzwv;
        } else {
            vec2 nxy = vec2(
               -0.15 * q_xy.x + 0.28 * q_xy.y - 0.12 * q_zwv.x,
                0.26 * q_xy.x + 0.24 * q_xy.y + 0.44
            );
            vec3 nzwv = vec3(
                0.12 * q_xy.x + 0.24 * q_zwv.x - 0.15 * q_zwv.y,
                0.24 * q_zwv.y + 0.15 * q_zwv.x - 0.20 * q_zwv.z - 0.2,
                0.24 * q_zwv.z - 0.15 * q_zwv.y - 0.25
            );
            q_xy = nxy; q_zwv = nzwv;
        }

        // --- ATTRACTOR WARM-UP DISCARD ---
        // Discard the first 30 iterations so off-attractor walk points aren't drawn
        if (i < 30) continue;

        vec2 hyperZW = vec2(q_zwv.x, q_zwv.y) * rot2D(zwRoll);
        vec2 hyperWV = vec2(q_zwv.y, q_zwv.z) * rot2D(wvRoll);

        vec3 pointOffset = vec3(q_xy.x, q_xy.y - spinePos, hyperZW.x + hyperWV.x * 0.5);
        pointOffset.xz *= rot2D(yaw);
        pointOffset.yz *= rot2D(pitch);

        vec3 worldXYZ = pointOffset - vec3(camPos.x, camPos.y, 0.0);

        vec3 projPos = worldXYZ * 0.25;
        float zDist = projPos.z + camPos.z;

        if (zDist > 0.05) {
            vec2 projUV = (projPos.xy * fov) / zDist;

            // --- VIEW-FRUSTUM CULLING ---
            if (abs(projUV.x) < (0.5 * (iResolution.x / iResolution.y) + 0.2) && abs(projUV.y) < 0.7) {
                
                float d = length(uv - projUV);

                // --- SUB-PIXEL PERSPECTIVE RADIUS SCALING ---
                // Scales footprint by distance and FOV zoom down to a fraction of a physical pixel
                float pixelSize = 1.0 / iResolution.y;
                float radius = max(pixelSize * 0.5, (0.75 * pixelSize * fov) / zDist);

                if (d < radius) {
                    vec3 deepStem  = vec3(0.01, 0.18, 0.05);
                    vec3 brightTip = vec3(0.30, 0.95, 0.20);
                    vec3 hyper5D   = vec3(0.85, 0.40, 1.00);

                    vec3 color = mix(deepStem, brightTip, clamp(q_xy.y / 10.0, 0.0, 1.0));
                    color = mix(color, hyper5D, clamp(abs(q_zwv.z) * 1.2, 0.0, 1.0));

                    float zoomWeightBoost = mix(1.0, 2.5, clamp(1.0 / fov, 0.0, 1.0));
                    vec3 hitColor = color * (1.0 - d / radius) * pointWeight * zoomWeightBoost;
                    
                    density += hitColor * exp(-density * 0.35);
                }
            }
        }
    }

    fragColor = vec4(density, 1.0);
}
